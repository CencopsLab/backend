PORT=8000
REQUEST_TIMEOUT_MS=0
# Rate limits use the client IP and an in-memory store. Configure trusted proxy hops in deployment.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
CHAT_RATE_LIMIT_MAX=20
CHAT_TRANSLATE_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_MAX=60
APK_UPLOAD_RATE_LIMIT_MAX=5
APK_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# Groq API key. Keep this file private and never put this key in the mobile app.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=768
GROQ_TEMPERATURE=0.2
# Comma-separated origins. Use * for local development only.
CORS_ORIGIN=*
